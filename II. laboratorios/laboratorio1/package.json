{
  "name": "pollclass-laboratorio1",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"bun run --cwd server dev\" \"bun run --cwd client dev\"",
    "client": "bun run --cwd client dev",
    "server": "bun run --cwd server dev",
    "build": "bun run --cwd client build",
    "install-all": "bun install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
